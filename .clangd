# =============================================================================
# .clangd — configuración del language server (VSCode, Neovim, etc.)
# =============================================================================
# Sin esto, clangd analiza los headers en su modo por defecto (C++17, sin
# -Iinclude) y marca errores falsos en todo el proyecto: "no type named
# 'strong_ordering' in namespace 'std'", "'<=>' is a single token in C++20",
# "use of undeclared identifier 'DIGIT_PAIRS_'", etc.
#
# T1.4 (auditoría 23 ago 2026) — herramientas del editor coherentes con el build.
# =============================================================================

CompileFlags:
  Add:
    - -std=c++20
    - -I./include
  Compiler: clang++

Diagnostics:
  UnusedIncludes: None
  Suppress:
    # __int128 no es ISO C++; el proyecto lo usa a propósito bajo guardas.
    - ext_int128_unsupported
